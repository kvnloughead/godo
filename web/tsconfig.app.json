{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "./tsconfig.strict.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true
  },
  // Type-check templates as strictly as script code: unknown props, attributes,
  // events, directives, and components are errors.
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
