# Docker Compose settings for local development.
#
#   cp .env.example .env
#
# Compose reads .env automatically. These are dev-only defaults; .env is
# gitignored, so change anything you like there. Don't reuse these values in
# production.

# Postgres. The database and user are created on first start of an empty
# volume. Changing them later has no effect until you run `make docker/reset`.
# Keep the password URL-safe (letters, digits, - and _): it is embedded in a
# postgres:// connection URL.
POSTGRES_DB=godo
POSTGRES_USER=godo
POSTGRES_PASSWORD=godo_dev_password

# Host ports. All are bound to 127.0.0.1, so nothing is exposed to your
# network. Change one if it clashes with something already running locally
# (for example a Postgres installed on the host).
POSTGRES_HOST_PORT=5432
API_PORT=4000
MAILPIT_UI_PORT=8025

# API settings. API_ENV is passed as the -env flag.
API_ENV=development
DEBUG=false
VERBOSE=false
SMTP_SENDER="GoDo <no-reply@godo.localhost>"
